# OMNI configuration. Copy to .env.local. Every variable is optional:
# OMNI runs with USGS alone and an in-memory store when nothing is set.
# These values are read on the server only. Never prefix them with NEXT_PUBLIC_.

# --- NASA FIRMS (wildfire / thermal anomaly layer) ---------------------------
# Free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without it the layer shows "credentials required" and nothing is fetched.
FIRMS_MAP_KEY=
# VIIRS_SNPP_NRT | VIIRS_NOAA20_NRT | VIIRS_NOAA21_NRT | MODIS_NRT
FIRMS_SOURCE=VIIRS_SNPP_NRT
# Days of detections to pull (1-5).
FIRMS_DAY_RANGE=2
# Global detections can exceed 100k per day. Keep the N highest fire radiative
# power detections; the layer reports when it truncates.
FIRMS_MAX_DETECTIONS=20000

# --- Supabase (PostgreSQL + PostGIS persistence) -----------------------------
# Apply supabase/migrations/*.sql first. When both are set, events and source
# status persist in Postgres instead of process memory.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingestion ---------------------------------------------------------------
# true : the Next.js server process polls the sources itself (default).
# false: run `npm run ingest` as a separate worker and let the web app read the store.
OMNI_INGEST_IN_PROCESS=true
